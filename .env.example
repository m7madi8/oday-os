APP_NAME="عدي أبو ضحى"
APP_ENV=production
# Generate once per install: php artisan key:generate (never copy a key from examples).
APP_KEY=
APP_DEBUG=false

APP_URL=http://localhost
PROTECTED_DOWNLOAD_DISK=local
PROTECTED_DOWNLOAD_ALLOW_UNSIGNED=false
REACT_URL=http://localhost:3001
CALENDAR_NATIVE_REDIRECT=invoiceninja://calendar_connection/complete

DB_CONNECTION=mysql
MULTI_DB_ENABLED=false

# MySQL must be running (port 3306). Optional: `docker compose up -d` in project root.
DB_HOST=localhost
DB_DATABASE=ninja
DB_USERNAME=ninja
DB_PASSWORD=ninja
DB_PORT=3306

DEMO_MODE=false

BROADCAST_DRIVER=log
LOG_CHANNEL=stack
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

POSTMARK_API_TOKEN=
# Local HTTP development sets this to false. A public deployment must keep it true
# and set TRUSTED_PROXIES to the reverse proxy so X-Forwarded-Proto is honored.
REQUIRE_HTTPS=true

# Optional extra gate for api/v1 login, signup, and password-reset (X-API-SECRET). ODAY mobile uses /api/oday/mobile/* without this header.
API_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/backup/google/callback
BACKUP_ENCRYPTION_KEY=
CRON_SECRET=

ODAY_DASHBOARD_URL=http://localhost:5173

GOOGLE_MAPS_API_KEY=
ERROR_EMAIL=
TRUSTED_PROXIES=
SCOUT_DRIVER=null 

NINJA_ENVIRONMENT=selfhost

# hosted_ninja posts the invoice HTML to Invoice Ninja's hosted renderer.
# A production deployment that must keep invoices local sets:
# PDF_GENERATOR=snappdf
# SNAPPDF_CHROMIUM_PATH=
# The path must point at the real Chromium executable and must not contain
# spaces. Snappdf on Windows joins the command without quotes, so
# "C:\Program Files\..." is executed as "C:\Program". Use an install location
# without spaces, or a junction to that executable. Do not patch the library.
# This example stays hosted_ninja so a workstation without Chromium still boots.
# It is not the production setting.
PDF_GENERATOR=hosted_ninja

PHANTOMJS_KEY='a-demo-key-with-low-quota-per-ip-address'
# Required only when using self-hosted Phantom PDF; leave empty otherwise.
PHANTOMJS_SECRET=

# Required for GET /update (post-deploy migrations). Generate a strong random value in production.
UPDATE_SECRET=

DELETE_PDF_DAYS=60
DELETE_BACKUP_DAYS=60

COMPOSER_AUTH='{"github-oauth": {"github.com": "${{ secrets.GITHUB_TOKEN }}"}}'

GOOGLE_PLAY_PACKAGE_NAME=
APPSTORE_PASSWORD=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=

# Generic OpenID Connect (OIDC) SSO.
# Leave OIDC_WELL_KNOWN blank to hide the "Sign in with ..." button.
# OIDC_WELL_KNOWN=https://sso.example.com/application/o/invoiceninja/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES="openid profile email"
# OIDC_PROVIDER_LABEL="OIDC"

NORDIGEN_SECRET_ID=
NORDIGEN_SECRET_KEY=

GOCARDLESS_CLIENT_ID=
GOCARDLESS_CLIENT_SECRET=

OPENEXCHANGE_APP_ID=

# Legacy sync for api/oday/items (X-ODAY-TOKEN). Required in production. Use a long random secret.
ODAY_DASHBOARD_TOKEN=
# رابط ملفات تحديث سطح المكتب. إن تُرك فارغًا يستخدم التطبيق: {عنوان الخادم}/desktop-updates
ODAY_UPDATE_FEED_URL=

ODAY_AI_API_KEY=
ODAY_AI_BASE_URL=https://api.openai.com/v1
ODAY_AI_MODEL=gpt-4o-mini

# Scheduler times (HH:MM format, UTC)
NINJA_AUTO_BILL_TIME=06:20
