# Local Expo Go / Android emulator only.
# `npm run oday` from the repo root overwrites oday-mobile/.env with the LAN IP.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
EXPO_PUBLIC_APP_ENV=development

# Physical phone or installable APK: use a host the device can reach.
# Example (same Wi-Fi as the Laravel server):
# EXPO_PUBLIC_API_URL=http://192.168.1.13:8000
# EXPO_PUBLIC_APP_ENV=preview
#
# Public server:
# EXPO_PUBLIC_API_URL=https://your-oday-os-host
# EXPO_PUBLIC_APP_ENV=production
#
# Never put Laravel secrets, API_SECRET, AI keys, or database credentials here.
