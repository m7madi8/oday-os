# Optional default server. You can also set the server on the login screen.
# `npm run oday` from the repo root overwrites oday-mobile/.env with the LAN IP.
EXPO_PUBLIC_API_URL=http://192.168.1.13:8000
EXPO_PUBLIC_APP_ENV=development

# Physical phone: never use 127.0.0.1 — use your PC LAN IP (same Wi-Fi).
# Example:
# EXPO_PUBLIC_API_URL=http://192.168.1.13:8000
# EXPO_PUBLIC_APP_ENV=preview
#
# Default mobile login (after `php artisan oday:bootstrap-mobile-user`):
# user: oday   password: oday   (email: oday@oday.local)
#
# Public server:
# EXPO_PUBLIC_API_URL=https://your-oday-os-host
# EXPO_PUBLIC_APP_ENV=production
#
# Never put Laravel secrets, API_SECRET, AI keys, or database credentials here.
